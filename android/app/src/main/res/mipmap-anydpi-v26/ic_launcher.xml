<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon: cream paper background + transparent seal foreground.
     Both layers are 108 dp; the system masks them into circle / squircle / etc.
     minSdk 26 means we ship adaptive-only, no legacy density mipmaps. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
