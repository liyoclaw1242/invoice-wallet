root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

[*.{kt,kts}]
ktlint_code_style = intellij_idea
ktlint_standard_no-wildcard-imports = enabled
# @Composable functions are PascalCase by convention — exempt them from function-naming.
ktlint_function_naming_ignore_when_annotated_with = Composable

[*.{yml,yaml,toml,json}]
indent_size = 2
