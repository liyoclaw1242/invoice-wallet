.gradle
build/

# Raw 2048² Gemini PNGs — too big to commit (≈70 MB total) and the processed
# WebPs in android/app/src/main/res/drawable-nodpi/ are the source of truth.
# The processing script + a README stay tracked.
temp-asset/*.png
temp-asset/*.jpg
temp-asset/*.jpeg

!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/
.kotlin

### Android ###
# Machine-local SDK path + secrets — never commit.
local.properties
*.apk
*.aab
*.ap_
*.dex
.cxx/
captures/
release/

### IntelliJ IDEA / Android Studio ###
# Ignore IDE config wholesale — regenerated on project open (monorepo opens android/).
.idea/
*.iws
*.iml
*.ipr
out/
!**/src/main/**/out/
!**/src/test/**/out/

